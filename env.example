# Copy to .env and fill. Never commit .env.

# =============================================================================
# BalkanID
# =============================================================================

# Public API URL (the tenant is determined by your API key)
BALKANID_PUBLIC_API_URL=https://your-tenant.balkanid.app/api/public

# Employee API key (BalkanID UI -> profile menu -> API Keys)
API_KEY_ID=
API_KEY_SECRET=

# Agent owner - the employee accountable for this agent. Must exist in your tenant.
BALKANID_AGENT_OWNER_EMAIL=

# Integration id for the connected Entra / M365 / Power Platform integration.
# Required for post-provision sync and for the identity gate.
INTEGRATION_ID=

# After provisioning, call syncIntegration so BalkanID discovers the new agent
TRIGGER_INTEGRATION_SYNC=true

# =============================================================================
# Which gate, which surface
# =============================================================================

# balkanid (reference) or sailpoint (alternate gate backend - see docs/SAILPOINT.md)
GATE_BACKEND=balkanid

# copilot-studio (Dataverse bot in a solution) or declarative-agent (M365 app package)
COPILOT_SURFACE=copilot-studio

# Gates to run. Both fail closed.
# ENTRA_IDENTITY_GATE also controls whether Terraform creates the agent's identity.
ENTRA_IDENTITY_GATE=false
AGENT_GATE=true

# After the gates, confirm the environment still matches what was approved before
# provisioning anything. Leave this on: it is what makes the approval record evidence
# of what was created rather than of what was asked for.
VERIFY_APPROVED_SCOPE=true
APPROVED_SCOPE_FILE=.approved-scope.json

# =============================================================================
# Agent metadata (shown to the approver)
# =============================================================================

AGENT_NAME=example-trial-intake-agent
AGENT_TYPE=copilot-studio
AGENT_PURPOSE="Clinical trial intake assistant, provisioned with BalkanID approval"

# Copilot Studio schema name - stable across environments, unlike the bot GUID
AGENT_SCHEMA_NAME=bkn_trialIntakeAssistant
# Dataverse bot GUID - only needed for the Application Insights resource
AGENT_BOT_ID=

# =============================================================================
# Microsoft - Entra service principal running the pipeline
# =============================================================================
# Needs, at minimum:
#   Power Platform:  registered via New-PowerAppManagementApp, Power Platform admin
#   Graph:           Application.ReadWrite.All, AppRoleAssignment.ReadWrite.All (identity stack)
#                    CopilotPackages.Read.All (discovery)
# See azure/PERMISSIONS.md for the full matrix.

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# =============================================================================
# Power Platform (COPILOT_SURFACE=copilot-studio)
# =============================================================================

POWER_PLATFORM_ENVIRONMENT_ID=
# Dataverse org URL for the same environment, used by discovery and pac auth
DATAVERSE_ORG_URL=https://yourorg.crm.dynamics.com

# The solution carrying the agent - build it with `pac copilot pack`
SOLUTION_ZIP_PATH=./build/BalkanIDAgentLifecycle_managed.zip
SOLUTION_UNIQUE_NAME=BalkanIDAgentLifecycle
SOLUTION_VERSION=1.0.0.0

PROVISION_COPILOT_AGENT=true
PUBLISH_AGENT=true

# Path to the Power Platform CLI, if `pac` is not on PATH
# PAC_CLI=
# Reuse an interactive `pac auth create` profile instead of a service principal
PAC_USE_EXISTING_AUTH=false

# =============================================================================
# Entra agent identity (ENTRA_IDENTITY_GATE=true)
# =============================================================================

PROVISION_AGENT_IDENTITY=false
ENTRA_IDENTITY_DISPLAY_NAME=example-trial-intake-agent
ENTRA_IDENTITY_DESCRIPTION="Copilot agent identity, created after approval"
ENTRA_SOURCE_TYPE="entra service principal"

# Graph application permissions the agent is asking for. This is the blast radius
# the approver reviews - keep it short.
ENTRA_GRAPH_PERMISSIONS=Sites.Selected,User.Read.All

# App id of the agent identity. Written by the identity stack; set it by hand when the
# identity already exists, or when the agent was issued an Entra Agent ID by the
# platform. Leaving it empty unbinds the environment application admin on re-apply.
AGENT_APP_ID=

# Directory role attached to the create request, if any
# ENTRA_IDENTITY_ROLE_NAME=

# =============================================================================
# Declarative agent (COPILOT_SURFACE=declarative-agent)
# =============================================================================

DECLARATIVE_AGENT_PACKAGE=./declarative-agent/appPackage/build/appPackage.zip
# personal | users | tenant. Read by the gate, and by m365agents.yml through
# declarative-agent/env/.env.<env>. Keep the two in step.
# Agents with actions or API plugins can only be shared at personal scope.
AGENT_SCOPE=personal

# Teams app id. manifest.json templates ${{TEAMS_APP_ID}}, and Graph rejects a package
# that still contains the placeholder. atk writes this during `atk provision`.
TEAMS_APP_ID=
# Submit for Teams admin review rather than publishing directly
AGENT_REQUIRES_REVIEW=false
TEAMSFX_ENV=dev

# Graph app-catalog publish is delegated-only. Leave blank to use device-code sign-in,
# or paste a delegated token with AppCatalog.ReadWrite.All.
GRAPH_ACCESS_TOKEN=
# AZURE_PUBLIC_CLIENT_ID=

# =============================================================================
# Discovery
# =============================================================================

DISCOVER_GRAPH_PACKAGES=true
# Exit non-zero when an ungoverned agent is found - useful as a CI guard
FAIL_ON_UNGOVERNED=false

# =============================================================================
# SailPoint (GATE_BACKEND=sailpoint) - optional, see docs/SAILPOINT.md
# =============================================================================

# isc = Identity Security Cloud (SaaS)   |   iiq = IdentityIQ (on-premises)
SAILPOINT_MODE=isc

# --- ISC ---
SAILPOINT_BASE_URL=https://your-tenant.api.identitynow.com
SAILPOINT_CLIENT_ID=
SAILPOINT_CLIENT_SECRET=
# The access profile / role / entitlement that represents "may create a Copilot agent"
SAILPOINT_ACCESS_ITEM_ID=
SAILPOINT_ACCESS_ITEM_TYPE=ACCESS_PROFILE
# Skip the identity lookup by supplying the requester's SailPoint identity id directly
# SAILPOINT_IDENTITY_ID=

# --- IdentityIQ ---
SAILPOINT_IIQ_URL=https://iiq.internal.example.com
SAILPOINT_IIQ_WORKFLOW=LCM Provisioning
SAILPOINT_IIQ_USERNAME=
SAILPOINT_IIQ_PASSWORD=
# SAILPOINT_IIQ_TOKEN=
# A workflow with no approval step completes instantly. The gate refuses to treat that
# as an approval unless you explicitly opt out here.
SAILPOINT_IIQ_REQUIRE_APPROVAL_ATTRIBUTE=true

# =============================================================================
# Polling
# =============================================================================

POLL_SECONDS=5
# Fail the apply if approval has not landed in this window (local default 15 min).
# CD uses APPROVAL_WAIT_MINUTES instead.
POLL_TIMEOUT_SECONDS=900

# =============================================================================
# Optional overrides
# =============================================================================
# Everything below has a working default. Listed so the knobs are discoverable
# rather than buried in the scripts.

# Identity gate: time-bound the request, and describe it differently from the agent
# ENTRA_IDENTITY_PURPOSE="Entra identity for a Microsoft Copilot agent"
# ENTRA_IDENTITY_DURATION_SECONDS=7776000
# ENTRA_IDENTITY_EXPIRATION_DATE=2027-01-01
# ENTRA_SIGN_IN_AUDIENCE=AzureADMyOrg
# ENTRA_IDENTITY_ROLE_NAME=
# ENTRA_IDENTITY_ROLE_ID=

# Shared aliases honoured by both gates, for parity with the AWS Bedrock reference
# LIFECYCLE_DURATION_SECONDS=
# LIFECYCLE_EXPIRATION_DATE=
# LIFECYCLE_POLICY_NAME=
# LIFECYCLE_POLICY_ID=

# Named pac auth profile created by publish_copilot_agent.py
# PAC_AUTH_PROFILE=balkanid-agent-lifecycle

# Non-standard SailPoint ISC token endpoint
# SAILPOINT_TOKEN_URL=

# Public API retry behaviour
# GQL_MAX_RETRIES=5
# GQL_RETRY_BACKOFF_SECONDS=2
